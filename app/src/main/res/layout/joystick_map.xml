<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="500dp"
    android:background="@drawable/border_window"
    android:elevation="12dp">

    <TextView
        android:id="@+id/joystick_map_tips"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primary_container"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:text="@string/joystick_map_tips"
        android:textColor="@color/on_surface"
        android:textSize="16sp" />

    <SearchView
        android:id="@+id/joystick_map_searchView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginEnd="44dp"
        android:background="@android:color/transparent"
        android:iconifiedByDefault="true"
        android:queryHint="@string/app_search_tips"
        app:showAsAction="collapseActionView|ifRoom" />

    <ImageButton
        android:id="@+id/map_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_panel"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        android:tint="@color/on_surface_variant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp">

        <com.baidu.mapapi.map.MapView
            android:id="@+id/map_joystick"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/circle_shape_bg"
            android:contentDescription="@string/cur_position"
            android:padding="11dp"
            android:src="@drawable/ic_home_position"
            android:tint="@color/colorAccent" />

        <ImageButton
            android:id="@+id/btnGo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="@dimen/space_lg"
            android:background="@drawable/circle_shape_bg"
            android:contentDescription="@string/fly_here"
            android:padding="13dp"
            android:src="@drawable/ic_position"
            android:tint="@color/colorPrimary" />

        <ImageButton
            android:id="@+id/btnSaveLocation"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_marginBottom="18dp"
            android:background="@drawable/circle_shape_bg"
            android:contentDescription="@string/search_favorite"
            android:padding="12dp"
            android:src="@drawable/ic_save"
            android:tint="@color/favorite" />

        <LinearLayout
            android:id="@+id/map_search_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:background="@drawable/bg_surface_panel"
            android:elevation="8dp"
            android:padding="@dimen/space_xs"
            android:visibility="gone">

            <ListView
                android:id="@+id/map_search_list_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp"
                android:listSelector="@android:color/transparent"
                android:padding="@dimen/space_xs" />
        </LinearLayout>

    </FrameLayout>
</FrameLayout>
