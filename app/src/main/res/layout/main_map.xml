<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".MainActivity"
    tools:showIn="@layout/main_content">

    <com.baidu.mapapi.map.MapView
        android:id="@+id/bdMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RadioGroup
        android:id="@+id/RadioGroupMapType"
        android:layout_width="108dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:background="@drawable/bg_map_control"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/mapNormal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="@color/colorAccent"
            android:checked="true"
            android:gravity="center_vertical"
            android:paddingEnd="6dp"
            android:text="@string/map_pic_normal"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/mapSatellite"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="@color/colorAccent"
            android:gravity="center_vertical"
            android:paddingEnd="6dp"
            android:text="@string/map_pic_sate"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/map_control_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_md"
        android:background="@drawable/bg_map_control"
        android:elevation="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/map_statement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/RadioGroupMapType"
        app:layout_constraintVertical_bias="0.72">

        <ImageButton
            android:id="@+id/input_pos"
            style="@style/MapControlButton"
            android:contentDescription="@string/input_button"
            android:src="@drawable/ic_input" />

        <ImageButton
            android:id="@+id/favorite_position"
            style="@style/MapControlButton"
            android:contentDescription="@string/search_favorite"
            android:src="@drawable/ic_save" />

        <ImageButton
            android:id="@+id/cur_position"
            style="@style/MapControlButton"
            android:contentDescription="@string/cur_position"
            android:src="@drawable/ic_home_position" />

        <ImageButton
            android:id="@+id/zoom_in"
            style="@style/MapControlButton"
            android:contentDescription="@string/zoom_in"
            android:src="@drawable/ic_zoom_in" />

        <ImageButton
            android:id="@+id/zoom_out"
            style="@style/MapControlButton"
            android:contentDescription="@string/zoom_out"
            android:src="@drawable/ic_zoom_out" />
    </LinearLayout>

    <TextView
        android:id="@+id/map_statement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_statement"
        android:gravity="center"
        android:text="@string/app_statement"
        android:textColor="@color/on_surface_variant"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="SmallSp" />

</androidx.constraintlayout.widget.ConstraintLayout>
