<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="500dp"
    android:background="@drawable/border_window"
    android:elevation="12dp"
    android:minWidth="300dp">

    <TextView
        android:id="@+id/joystick_his_tips"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primary_container"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:text="@string/joystick_history_tips"
        android:textColor="@color/on_surface"
        android:textSize="16sp" />

    <SearchView
        android:id="@+id/joystick_his_searchView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginEnd="44dp"
        android:background="@android:color/transparent"
        android:iconifiedByDefault="true"
        android:queryHint="@string/app_search_tips"
        app:showAsAction="collapseActionView|ifRoom" />

    <ImageButton
        android:id="@+id/joystick_his_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_panel"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        android:tint="@color/on_surface_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/joystick_his_record_no_textview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/space_lg"
            android:text="@string/history_idle"
            android:textAlignment="center"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp" />

        <ListView
            android:id="@+id/joystick_his_record_list_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="@dimen/space_sm"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
